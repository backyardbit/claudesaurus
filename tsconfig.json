{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": { "~/*": ["./src/pr/*"] }
  },
  "include": ["src", "scripts", "bin", "vite.config.mts", "vite.pr.config.mts", "vitest.config.mts"]
}
