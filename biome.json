{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!tools/oxlint/anti-slop"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/pr/components/pullRequest/**",
        "src/pr/components/ui/**",
        "src/pr/components/diffs/**",
        "src/pr/components/DiffWorkerPoolProvider.tsx",
        "src/pr/components/DiffPanelShell.tsx",
        "src/pr/lib/diffRendering.ts",
        "src/pr/lib/diffFileContents.ts",
        "src/pr/reviewCommentContext.ts"
      ],
      "linter": {
        "enabled": false
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
